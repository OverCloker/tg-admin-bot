BOT_TOKEN=123456:replace_with_token_from_botfather
BOT_API_URL=https://api.telegram.org
# Required only for the optional local Telegram Bot API server.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Keep local by default. For Windows publisher over Tailscale, set to the server Tailscale IP.
BOT_API_PORT_BIND=127.0.0.1
DB_PATH=bot.sqlite3
BOT_ADMIN_IDS=
OWNER_ID=
ADMIN_API_KEY=change_this_long_random_key
ADMIN_ACTOR_ID=
ADMIN_ACCESS_KEYS_FILE=admin_access_keys.json
# Public HTTPS API origin; required for inline alert-map photo delivery.
ADMIN_PUBLIC_URL=
MINI_APP_URL=
CLOUDFLARE_TUNNEL_TOKEN=
DEPLOY_NOTIFY_CHAT_ID=
DEPLOY_NOTIFY_THREAD_ID=
# Optional comma-separated targets: chat_id or chat_id:message_thread_id.
# If empty, every registered group is notified; the legacy target is included too.
DEPLOY_NOTIFY_TARGETS=
ALERTS_API_TOKEN=
# UkraineAlarm API v3 key; sent only in the Authorization header.
UKRAINE_ALARM_API_TOKEN=
USER_SUBSCRIPTION_STARS=100
AUDD_API_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
FFMPEG_PATH=
# Optional SOCKS5 proxy for YouTube/YouTube Music only (not Instagram).
# On Docker/Linux, use the private host relay described in DOCKER_DEBIAN.md.
YOUTUBE_PROXY_URL=
WHISPER_MODEL=small
# Optional text chat; empty allowlist or key means disabled everywhere.
AI_CHAT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Explicit chat IDs (negative groups, positive private chats), comma-separated.
AI_CHAT_IDS=
# Shared per UTC day, persisted in SQLite. Not a Google quota or billing cap.
AI_CHAT_DAILY_LIMIT=200
