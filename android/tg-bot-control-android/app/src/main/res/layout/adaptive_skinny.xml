<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/aw_body" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_surface">
<TextView android:id="@+id/aw_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Чутове · 2.2" android:textColor="#1B2232" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
<LinearLayout android:id="@+id/aw_status_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:layout_marginTop="6dp" android:background="@drawable/widget_on"><ImageView android:id="@+id/aw_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/><TextView android:id="@+id/aw_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Включение" android:textColor="#237244" android:textSize="12sp" android:textStyle="bold" android:maxLines="3"/></LinearLayout>
<TextView android:id="@+id/aw_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="18:00" android:textSize="24sp" android:textStyle="bold" android:textColor="#1B2232"/>
<TextView android:id="@+id/aw_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#746E68" android:maxLines="3"/>
<LinearLayout android:id="@+id/aw_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp"/>
<ImageView android:id="@+id/aw_timeline" android:layout_width="match_parent" android:layout_height="28dp" android:visibility="gone"/>
<TextView android:id="@+id/aw_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#746E68" android:maxLines="2"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/aw_all_day_art" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/></FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/aw_updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="#746E68" android:maxLines="2"/><ImageView android:id="@+id/aw_refresh" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_refresh" android:padding="3dp" android:contentDescription="Обновить график"/></LinearLayout></LinearLayout>
