<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/aw_body" android:forceDarkAllowed="false" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/aw_background" android:forceDarkAllowed="false" android:src="@drawable/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:forceDarkAllowed="false" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
        <TextView android:id="@+id/aw_title" android:forceDarkAllowed="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#1B2232" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"/>
        <TextView android:id="@+id/aw_status" android:forceDarkAllowed="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:textColor="#176B43" android:maxLines="2" android:includeFontPadding="false"/>
        <TextView android:id="@+id/aw_time" android:forceDarkAllowed="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="#1B2232" android:includeFontPadding="false"/>
    </LinearLayout>
</FrameLayout>
