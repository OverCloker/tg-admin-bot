<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/aw_body" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_surface">
